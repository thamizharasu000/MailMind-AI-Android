PORT=3000
NODE_ENV=development
# For HTTPS tunnel deployments, keep COOKIE_SECURE=true.
# Set COOKIE_SECURE=false only for local, non-public HTTP debugging.
COOKIE_SECURE=true
GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_oauth_client_secret
# Must exactly match the redirect URI configured in Google Cloud Console.
# Use the same public HTTPS host for MAILMIND_API_BASE and this callback.
GOOGLE_CALLBACK_URL=https://YOUR_PUBLIC_BACKEND_HOST/auth/google/callback
SESSION_SECRET=replace_with_a_long_random_secret
APP_JWT_SECRET=replace_with_a_different_long_random_secret
GEMINI_API_KEY=replace_with_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash
